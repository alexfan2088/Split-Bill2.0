<!--pages/home/home.wxml-->
<wxs module="utils" src="./home.wxs"></wxs>
<view class="container">
  <view class="header">
    <view class="user-info">
      <view wx:if="{{userName}}" class="signed-in-info">
        <text class="user-label">当前用户：{{userName}}</text>
        <text class="login-link" bindtap="switchAccount">切换账号 / 注册</text>
      </view>
      <view wx:else class="guest-info">
        <text class="user-label">游客模式：可先浏览功能说明</text>
        <text class="login-link" bindtap="goLogin">登录/注册</text>
      </view>
    </view>
  </view>
  
  <view class="page-header">
    <text class="page-title">活动列表</text>
    <button class="btn-add" bindtap="createActivity">+ 创建活动</button>
  </view>

  <view wx:if="{{!userName}}" class="guest-guide">
    <text class="guest-guide-title">多人 AA 记账</text>
    <text>支持创建活动、记录账单、成员分摊和结算。使用记账功能时，再由你主动选择注册或登录。</text>
  </view>
  
  <view class="activity-list">
    <view wx:if="{{activities.length === 0}}" class="empty-tip">
      <text>暂无活动，点击上方按钮创建活动</text>
    </view>
    
    <view wx:for="{{activities}}" wx:key="_id" class="activity-item" bindtap="openActivity" data-id="{{item._id}}" data-is-creator="{{item.isCreator}}">
      <view class="activity-header">
        <view class="activity-name {{item.isCreator ? 'creator-name' : ''}}">
          {{item.name}}
          <text wx:if="{{item.isParent}}" class="prepaid-tag">（一级活动）</text>
          <text wx:if="{{item.isPrepaid}}" class="prepaid-tag">（预存）</text>
        </view>
      </view>
      <view class="activity-meta">
        <text wx:if="{{item.type}}">{{item.type}} | </text>
        <text>成员：{{utils.joinMembers(item.memberNames)}}</text>
      </view>
    </view>
  </view>
</view>
