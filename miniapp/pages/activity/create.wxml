<!--pages/activity/create.wxml-->
<view class="container">
  <view class="form">
    <view class="form-item">
      <text class="label">活动名称</text>
      <input class="input" type="text" placeholder="例如：周末聚餐" value="{{name}}" bindinput="onNameInput" maxlength="20" />
    </view>

    <view wx:if="{{!parentId}}" class="form-item">
      <view class="switch-item">
        <text class="switch-label">父活动</text>
        <switch checked="{{isParent}}" bindchange="toggleParent" />
      </view>
      <view class="hint">父活动不能直接记账，参与人员和结算由二级活动自动汇总。</view>
    </view>

    <view wx:if="{{parentId}}" class="parent-notice">当前创建的是「{{parentName}}」下的二级活动</view>
    

    <view wx:if="{{!isParent}}" class="form-item">
      <text class="label">参与成员（<text class="label-highlight">逐个添加</text>）</text>
      <view class="hint">提示：创建者（{{creator}}）会自动添加在第一位，且不可删除</view>
      <view class="member-input-row">
        <input class="input member-input" type="text" placeholder="输入成员姓名" value="{{newMemberName}}" bindinput="onNewMemberInput" maxlength="20" />
        <button class="btn btn-secondary member-add-btn" bindtap="addMember">添加</button>
      </view>
      <view class="member-tags">
        <view wx:for="{{memberNames}}" wx:key="name" class="member-tag {{item === creator ? 'member-tag-creator' : ''}}" bindlongpress="onMemberLongPress" data-name="{{item}}">
          {{item}}
        </view>
      </view>
      <view wx:if="{{isEdit}}" class="hint">长按成员名字，可以进行修改或删除</view>
    </view>
    
    <view class="form-item">
      <text class="label">备注</text>
      <!-- 显示模式：格式化显示默认备注 -->
      <view wx:if="{{!remarkEditing && !isEdit && remark}}" class="remark-display" bindtap="startEditRemark">
        <text class="remark-text">
          <block wx:for="{{formattedRemark}}" wx:key="index">
            <text class="{{item.highlight ? 'remark-highlight' : ''}}">{{item.text}}</text>
          </block>
        </text>
        <text class="remark-edit-hint">点击编辑</text>
      </view>
      <!-- 编辑模式：使用textarea -->
      <textarea wx:else class="textarea textarea-remark" placeholder="可选" value="{{remark}}" bindinput="onRemarkInput" auto-height="{{true}}" />
    </view>
    
    <view wx:if="{{showPrepaidOption && !isParent}}" class="form-item">
      <view class="switch-item">
        <text class="switch-label">预存</text>
        <switch checked="{{isPrepaid}}" bindchange="togglePrepaid" disabled="{{isEdit && originalIsPrepaid}}" />
      </view>
      <view wx:if="{{isEdit && originalIsPrepaid}}" class="switch-hint">创建时已选择预存，不可修改</view>
    </view>
    
    <view wx:if="{{isPrepaid && !isParent}}" class="form-item">
      <text class="label">保管人员</text>
      <view class="keeper-tags">
        <view wx:for="{{keeperList}}" wx:key="name" class="keeper-tag {{keeper === item.name ? 'active' : ''}}" bindtap="selectKeeper" data-name="{{item.name}}">
          {{item.name}}
        </view>
      </view>
    </view>
    
    <button class="btn btn-full" bindtap="saveActivity">{{isEdit ? '更新' : '创建'}}</button>
  </view>
</view>
