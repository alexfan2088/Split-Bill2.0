<!--pages/activity/detail.wxml-->
<view class="container">
  <view class="header">
    <view class="activity-header">
        <view class="activity-title-row">
          <view class="activity-title {{isCreator ? 'creator-title' : ''}}">
            {{activity.name}}
            <text wx:if="{{isParent}}" class="parent-tag">（父活动）</text>
            <text wx:if="{{isPrepaid}}" class="prepaid-tag">（预存）</text>
          </view>
          <button class="btn-edit-activity {{isCreator ? '' : 'disabled'}}" size="mini" bindtap="editActivity" disabled="{{!isCreator}}">编辑</button>
        </view>
      <view class="activity-creator" wx:if="{{activity.creator}}">
        <text>创建者：<text class="creator-name">{{activity.creator}}</text></text>
        <text wx:if="{{isPrepaid && keeper}}" class="keeper-info">保管者：<text class="keeper-name">{{keeper}}</text></text>
      </view>
    </view>
    <view class="activity-meta">{{activityMeta}}</view>
    
    <!-- 结算信息 -->
    <view class="summary-info">
      <view class="summary-info-item summary-info-row">
        <view class="summary-info-left">
          <text class="summary-label">总支出：</text>
          <text class="summary-value amount">¥{{total}}</text>
        </view>
        <view class="summary-actions">
          <button wx:if="{{!isParent}}" class="btn-download-activity" size="mini" bindtap="downloadActivityPdf">下载</button>
          <button wx:if="{{isCreator}}" class="btn-delete-activity" size="mini" bindtap="deleteActivity">删除</button>
        </view>
      </view>
      <view class="summary-info-item">
        <text wx:if="{{isParent}}" class="summary-label">二级活动：{{childCount}} 个</text>
        <text wx:else class="summary-label">{{dateRange}} | 账单数量：{{bills.length}} 条</text>
      </view>
    </view>
  </view>
  
  <view class="tabs">
    <view wx:if="{{!isParent}}" class="tab {{currentTab === 'bills' ? 'active' : ''}}" bindtap="switchTab" data-tab="bills">账单</view>
    <view wx:if="{{isPrepaid}}" class="tab {{currentTab === 'recharge' ? 'active' : ''}}" bindtap="switchTab" data-tab="recharge">预存</view>
    <view class="tab {{currentTab === 'summary' ? 'active' : ''}}" bindtap="switchTab" data-tab="summary">结算</view>
    <button wx:if="{{isParent}}" class="btn-add-inline" bindtap="addChildActivity">+二级活动</button>
    <button wx:else class="btn-add-inline" bindtap="addBill">+账单</button>
  </view>
  
  <!-- 账单 Tab -->
  <view wx:if="{{currentTab === 'bills'}}" class="tab-content">
    <view class="bill-list">
      <view wx:if="{{bills.length === 0}}" class="empty-tip">
        <text>暂无账单记录</text>
      </view>
      
      <view wx:for="{{bills}}" wx:key="_id" class="bill-item" bindtap="viewBill" data-bill="{{item}}">
        <view class="bill-left">
          <view class="bill-circles">
            <view wx:for="{{item.circles}}" wx:key="index" wx:for-item="circle" class="circle {{circle.type}}" style="margin-left: {{circle.marginLeft}}; {{circle.type === 'pie' ? '' : (circle.type === 'split' ? '' : 'background-color: ' + circle.color + ';')}}">
              <view wx:if="{{circle.type === 'pie'}}" class="circle-pie">
                <canvas type="2d" id="pieCanvas_{{item._id}}" class="pie-canvas" data-sectors="{{circle.sectors}}"></canvas>
              </view>
              <text wx:if="{{circle.surname && circle.type !== 'pie' && circle.type !== 'split'}}">{{circle.surname}}</text>
            </view>
          </view>
          <view class="bill-weight">{{item.totalCount}}</view>
          <view class="bill-info">
            <view class="bill-title {{item.isCreator ? 'creator-bill-title' : ''}}">
              {{item.title}}
            </view>
            <view class="bill-date">
              {{item.date}}
              <text wx:if="{{isPrepaid && item.isPayerAutoModified && item.originalPayer}}" class="bill-original-payer"> {{item.originalPayer}}</text>
            </view>
          </view>
        </view>
        <view class="bill-right">
          <view class="bill-amount">¥{{item.amount}}</view>
        </view>
      </view>
    </view>
  </view>
  
  <!-- 预存 Tab -->
  <view wx:if="{{currentTab === 'recharge' && isPrepaid}}" class="tab-content">
    <view class="recharge-content">
      <view class="recharge-summary">
        <view class="recharge-summary-item">
          <text class="recharge-label">充值总金额：</text>
          <text class="recharge-value amount">¥{{totalRecharge}}</text>
        </view>
      </view>
      
      <view class="recharge-list">
        <view wx:if="{{recharges.length === 0}}" class="empty-tip">
          <text>暂无充值记录</text>
        </view>
        
        <!-- 表头 -->
        <view wx:if="{{recharges.length > 0}}" class="recharge-header">
          <view class="recharge-header-item">日期</view>
          <view class="recharge-header-item">预存人</view>
          <view class="recharge-header-item">金额</view>
          <view class="recharge-header-item">记录人</view>
          <view class="recharge-header-item">操作</view>
        </view>
        
        <view wx:for="{{recharges}}" wx:key="_id" class="recharge-item" bindtap="viewRecharge" data-id="{{item._id}}">
          <view class="recharge-info">
            <view class="recharge-date">{{item.date}}</view>
            <view class="recharge-payer">{{item.payer}}</view>
            <view class="recharge-amount">¥{{item.amount}}</view>
            <view class="recharge-recorder">{{item.recorder || item.creator}}</view>
          </view>
          <view class="recharge-actions">
            <button wx:if="{{item.isAuto}}" class="btn-delete disabled" size="mini" disabled="true" catchtap="noop">自动</button>
            <button wx:else class="btn-delete {{item.isCreator ? '' : 'disabled'}}" size="mini" catchtap="deleteRecharge" disabled="{{!item.isCreator}}" data-id="{{item._id}}" data-payer="{{item.payer}}" data-amount="{{item.amount}}">删除</button>
          </view>
        </view>
      </view>
      
      <button class="btn-add" bindtap="addRecharge">+ 添加充值</button>
    </view>
  </view>
  
  <!-- 结算 Tab -->
  <view wx:if="{{currentTab === 'summary'}}" class="tab-content">
    <view class="summary-content">
      <view wx:if="{{isParent}}" class="child-activity-list">
        <view class="section-title">二级活动结算</view>
        <view wx:if="{{childActivities.length === 0}}" class="empty-tip">暂无二级活动，请先新增二级活动</view>
        <view wx:for="{{childActivities}}" wx:key="_id" class="child-activity-item" bindtap="openChildActivity" data-id="{{item._id}}">
          <view class="child-activity-main">
            <view class="child-activity-name">{{item.name}}</view>
          </view>
          <view class="child-activity-total"><text class="child-activity-total-label">总支出</text> ¥{{item.total}}</view>
        </view>
      </view>
      <!-- 预存活动的特殊显示 -->
      <view wx:if="{{isPrepaid}}" class="prepaid-summary">
        <view class="prepaid-item">
          <text class="prepaid-label">总金额（充值）：</text>
          <text class="prepaid-value amount">¥{{totalRecharge}}</text>
        </view>
        <view class="prepaid-item">
          <text class="prepaid-label">消费金额：</text>
          <text class="prepaid-value">¥{{totalConsume}}</text>
        </view>
        <view class="prepaid-item">
          <text class="prepaid-label">剩余金额：</text>
          <text class="prepaid-value {{remaining < 0 ? 'negative' : 'positive'}}">¥{{remaining}}</text>
        </view>
        <view wx:if="{{remaining < 0}}" class="recharge-alert">
          <text class="alert-text">⚠️ 余额不足，请及时充值！</text>
        </view>
      </view>
      
      <view wx:if="{{!isParent}}" class="member-list">
        <view wx:for="{{members}}" wx:key="name" class="member-item" bindtap="onMemberTap" data-name="{{item.name}}">
          <view class="member-info">
            <view class="member-name">{{item.name}}</view>
            <view class="member-detail">
              <text wx:if="{{isPrepaid && item.isKeeper}}">{{item.name}}消费：¥{{item.bal.shouldPay}} | {{item.name}}支出：¥{{item.bal.paid}}</text>
              <text wx:else>实付：¥{{item.bal.paid}} | 应付：¥{{item.bal.shouldPay}}</text>
            </view>
          </view>
          <view class="member-balance {{item.bal.balance < 0 ? 'negative' : 'positive'}}">
            余额：¥{{item.bal.balance}}
          </view>
        </view>
      </view>
      
    </view>
  </view>

    <!-- 成员账单列表弹层 -->
    <view wx:if="{{showMemberBills}}" class="modal-mask" catchtouchmove="noop">
      <view class="modal">
        <view class="modal-header">
          <text>{{selectedMemberName}} 账单明细</text>
          <text class="modal-close" bindtap="closeMemberBills">×</text>
        </view>
        <scroll-view class="modal-body" scroll-y="true" show-scrollbar="{{false}}">
          <!-- 汇总信息 -->
          <view class="summary-section">
            <view class="summary-row" wx:if="{{showSelectedMemberConsume}}">
              <text class="summary-label">{{selectedMemberName}}消费：</text>
              <text class="summary-value income">¥{{selectedMemberIncome}}</text>
            </view>
            <view class="summary-row" wx:if="{{showSelectedMemberExpense}}">
              <text class="summary-label">{{selectedMemberName}}支出：</text>
              <text class="summary-value expense">¥{{selectedMemberExpense}}</text>
            </view>
            <view class="summary-row">
              <text class="summary-label">余额：</text>
              <text class="summary-value balance {{selectedMemberBalance >= 0 ? 'positive' : 'negative'}}">¥{{selectedMemberBalance}}</text>
            </view>
          </view>
          
          <!-- 消费账单列表 -->
          <view class="bill-section" wx:if="{{showSelectedMemberConsume}}">
            <view class="section-title">{{selectedMemberName}}消费</view>
            <view wx:if="{{selectedMemberBills.length === 0}}" class="empty-tip">暂无{{selectedMemberName}}消费账单</view>
            <view wx:if="{{selectedMemberBills.length > 0}}" class="bill-table">
              <view class="bill-table-header">
                <text class="col-name">名称</text>
                <text class="col-payer">{{isPrepaid && selectedMemberName === keeper ? '预存人' : '付款人'}}</text>
                <text class="col-user">金额</text>
                <text class="col-date">日期</text>
              </view>
              <view wx:for="{{selectedMemberBills}}" wx:key="index" class="bill-table-row" bindtap="openBillFromModal" data-id="{{item._id}}" data-is-recharge="{{item.isRecharge ? 'true' : 'false'}}">
                <text class="col-name">{{item.displayTitle || item.title}}</text>
                <text class="col-payer">{{item.payer}}</text>
                <text class="col-user">¥{{item.userAmount}}</text>
                <text class="col-date">{{item.date}}</text>
              </view>
            </view>
          </view>
          
          <!-- 支出账单列表 -->
          <view class="bill-section" wx:if="{{showSelectedMemberExpense}}">
            <view class="section-title">{{selectedMemberName}}支出</view>
            <view wx:if="{{selectedMemberPaidBills.length === 0}}" class="empty-tip">暂无{{selectedMemberName}}支出账单</view>
            <view wx:if="{{selectedMemberPaidBills.length > 0}}" class="bill-table">
              <view class="bill-table-header">
                <text class="col-name">名称</text>
                <text class="col-payee">去向</text>
                <text class="col-total">总金额</text>
                <text class="col-date">日期</text>
              </view>
              <view wx:for="{{selectedMemberPaidBills}}" wx:key="index" class="bill-table-row" bindtap="openBillFromModal" data-id="{{item._id}}" data-is-recharge="{{item.isRecharge ? 'true' : 'false'}}">
                <text class="col-name {{item.isCreator ? 'creator-bill-title' : ''}}">{{item.displayTitle || item.title}}</text>
                <text class="col-payee">{{item.payee}}</text>
                <text class="col-total">¥{{item.totalAmount}}</text>
                <text class="col-date">{{item.date}}</text>
              </view>
            </view>
          </view>
          <!-- 底部空行防止内容被裁切 -->
          <view class="modal-spacer"></view>
        </scroll-view>
      </view>
    </view>

    <!-- PDF 下载提醒弹层 -->
    <view wx:if="{{showPdfReminderModal}}" class="pdf-modal-mask" catchtouchmove="noop">
      <view class="pdf-reminder-modal">
        <view class="pdf-modal-title">下载提醒</view>
        <view class="pdf-modal-content">已{{pdfReminderDiffDays}}天未下载活动信息，是否现在下载？</view>
        <view class="pdf-reminder-actions">
          <button class="pdf-reminder-btn ghost" bindtap="onPdfReminderNever">永不提醒</button>
          <button class="pdf-reminder-btn ghost" bindtap="onPdfReminderLater">30天后提醒</button>
          <button class="pdf-reminder-btn primary" bindtap="onPdfReminderDownload">确定下载</button>
        </view>
      </view>
    </view>

    <!-- PDF 保存指引弹层 -->
    <view wx:if="{{showPdfGuideModal}}" class="pdf-modal-mask" catchtouchmove="noop">
      <view class="pdf-modal">
        <view class="pdf-modal-title">PDF已生成</view>
        <view class="pdf-modal-content">{{pdfGuideText}}</view>
        <button class="pdf-modal-btn" bindtap="closePdfGuideModal">知道了</button>
      </view>
    </view>
    
    <!-- 隐藏导出用Canvas -->
    <canvas canvas-id="pdfCanvas" class="pdf-canvas" style="width: {{pdfCanvasWidth}}px; height: {{pdfCanvasHeight}}px;"></canvas>
</view>
