/* pages/login/login.wxss */
.container {
  display: flex;
  justify-content: center;
  align-items: center;
  min-height: 100vh;
  background-color: #f5f5f5;
}

.login-card {
  width: 90%;
  max-width: 500rpx;
  background-color: white;
  border-radius: 16rpx;
  padding: 60rpx 40rpx;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.1);
}

.title {
  font-size: 48rpx;
  font-weight: bold;
  text-align: center;
  color: #28a745;
  margin-bottom: 20rpx;
}

.subtitle {
  font-size: 28rpx;
  text-align: center;
  color: #666;
  margin-bottom: 60rpx;
}

.form-item {
  margin-bottom: 40rpx;
}

.label {
  display: block;
  font-size: 28rpx;
  color: #333;
  margin-bottom: 16rpx;
}

.input {
  width: 100%;
  height: 80rpx;
  padding: 0 20rpx;
  border: 2rpx solid #ddd;
  border-radius: 8rpx;
  font-size: 28rpx;
}

.input:focus {
  border-color: #007bff;
}

.username-check {
  margin-top: 14rpx;
}

.username-check-text {
  display: block;
  font-size: 24rpx;
  line-height: 1.5;
  color: #666;
}

.username-check-text.checking {
  color: #666;
}

.username-check-text.available {
  color: #16803c;
  font-weight: bold;
}

.username-check-text.occupied {
  color: #c62828;
  font-weight: bold;
}

.username-suggestions {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 12rpx;
  margin-top: 12rpx;
}

.username-suggestions-label {
  font-size: 24rpx;
  color: #555;
}

.username-suggestion {
  padding: 8rpx 14rpx;
  border: 2rpx solid #16803c;
  border-radius: 8rpx;
  color: #16803c;
  font-size: 24rpx;
  line-height: 1.2;
}

.password-wrapper {
  position: relative;
  width: 100%;
}

.toggle-password {
  position: absolute;
  right: 20rpx;
  top: 50%;
  transform: translateY(-50%);
  color: #007bff;
  font-size: 24rpx;
  padding: 8rpx 16rpx;
  z-index: 10;
}

.status-text {
  display: block;
  font-size: 24rpx;
  margin-top: 12rpx;
  text-align: center;
}

.status-text.blue {
  color: #007bff;
  font-weight: bold;
}

.status-text.green {
  color: #28a745;
  font-weight: bold;
}

.status-text.red {
  color: #dc3545;
  font-weight: bold;
}

.status-text.orange {
  color: #ff9800;
  font-weight: bold;
}

.link-text {
  color: #007bff;
  font-size: 26rpx;
  text-decoration: underline;
  cursor: pointer;
}

.recovery-link-row { margin-top: -12rpx; text-align: center; }
.security-question { display: block; padding: 18rpx 20rpx; background: #f6f8f7; border-radius: 8rpx; color: #333; font-size: 28rpx; line-height: 1.5; }

.agreement-row {
  display: flex;
  align-items: flex-start;
  margin: -8rpx 0 28rpx;
}

.agreement-row checkbox { transform: scale(0.8); margin: 0 6rpx 0 -8rpx; }
.agreement-text { flex: 1; font-size: 23rpx; line-height: 1.6; color: #666; }
.agreement-link { color: #1677c8; }
