.container { min-height: 100vh; background: #f5f5f5; }
.tabs { display: flex; background: #fff; border-bottom: 1rpx solid #eee; }
.tab { flex: 1; padding: 26rpx 0; color: #666; text-align: center; font-size: 28rpx; }
.tab.active { color: #176b3a; font-weight: bold; border-bottom: 4rpx solid #176b3a; }
.content { margin: 20rpx; padding: 32rpx 28rpx; background: #fff; border-radius: 12rpx; }
.title { color: #222; font-size: 36rpx; font-weight: bold; text-align: center; }
.date { margin: 18rpx 0 28rpx; color: #999; font-size: 24rpx; text-align: center; }
.section { margin-top: 26rpx; color: #444; font-size: 27rpx; line-height: 1.8; white-space: pre-wrap; }
.section-title { display: block; margin-bottom: 6rpx; color: #222; font-weight: bold; }
