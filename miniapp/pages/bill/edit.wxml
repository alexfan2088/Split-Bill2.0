<!--pages/bill/edit.wxml-->
<view class="container">
  <view class="form">
    <view class="form-item">
      <text class="label">金额（元）</text>
      <input class="input" type="text" placeholder="0.00" value="{{amount}}" bindinput="onAmountInput" bindconfirm="onAmountConfirm" bindblur="onAmountBlur" disabled="{{isReadOnly}}" />
      <text class="hint">可输入 3+5= 自动计算</text>
    </view>
    
    <view class="form-item" style="display:none">
      <text class="label">账单类型</text>
      <view class="type-tags">
        <view wx:for="{{commonTypes}}" wx:key="*this" class="type-tag {{billType === item ? 'active' : ''}}" bindtap="selectBillType" bindlongpress="deleteType" data-type="{{item}}">
          {{item}}
        </view>
      </view>
      <input class="input" type="text" placeholder="或输入自定义类型" value="{{billType}}" bindinput="onBillTypeInput" bindblur="onBillTypeBlur" maxlength="10" disabled="{{isReadOnly}}" />
    </view>
    
    <view class="form-item">
      <text class="label">账单名称</text>
      <view class="title-input-row">
        <input class="input input-title" type="text" placeholder="例如：晚餐、山姆购物" value="{{title}}" bindinput="onTitleInput" maxlength="20" disabled="{{isReadOnly}}" />
      </view>
      <view wx:if="{{!isReadOnly && !isEdit && matchedBillTitleOptions.length > 0}}" class="recent-titles">
        <view class="recent-titles-label">匹配账单名称：</view>
        <view class="recent-titles-buttons">
          <view wx:for="{{matchedBillTitleOptions}}" wx:key="id" class="btn-title-item" bindtap="selectTitle" data-id="{{item.id}}">
            {{item.title}}
            <text class="btn-title-item-sub">{{item.subtitle}}</text>
          </view>
        </view>
      </view>
      <text class="hint">最多20个汉字</text>
    </view>
    
    <view class="form-item">
      <text class="label">时间</text>
      <view class="datetime-row">
        <picker class="picker-wrapper picker-date" mode="date" value="{{date}}" bindchange="onDateChange" disabled="{{isReadOnly}}">
          <view class="picker picker-inline">{{date || '选择日期'}}</view>
        </picker>
        <view class="datetime-spacer"></view>
        <picker class="picker-wrapper picker-time" mode="time" value="{{time}}" bindchange="onTimeChange" disabled="{{isReadOnly}}">
          <view class="picker picker-inline">{{time || '选择时间'}}</view>
        </picker>
      </view>
    </view>
    
    <view class="form-item">
      <view class="form-item-header-inline">
        <text class="label label-inline">付款人</text>
        <button wx:if="{{!isReadOnly}}" class="btn btn-save" bindtap="saveBill">{{isEdit ? '更新账单' : '保存账单'}}</button>
      </view>
      <picker range="{{payerList}}" range-key="name" value="{{payerIndex}}" bindchange="onPayerChange" disabled="{{isReadOnly || payerDisabled}}">
        <view class="picker {{payerDisabled ? 'picker-disabled' : ''}}">{{payerList[payerIndex] ? payerList[payerIndex].name : '选择付款人'}}</view>
      </picker>
      <view wx:if="{{isPrepaid && keeper}}" class="hint">预存活动，默认付款人为保管人员（{{keeper}}），可选择其他人员</view>
    </view>
    
    <view class="form-item">
      <text class="label">消费方（选择权重：0表示不参与，1-3表示人数）</text>
      <view class="participants-list">
        <view wx:for="{{participants}}" wx:key="name" class="participant-item">
          <view class="participant-name">{{item.name}}</view>
          <radio-group bindchange="onWeightChange" data-name="{{item.name}}" disabled="{{isReadOnly}}">
            <view class="weight-options">
              <view wx:for="{{[0,1,2,3]}}" wx:key="*this" wx:for-item="w" class="weight-option">
                <radio value="{{w}}" checked="{{item.weight === w}}" disabled="{{isReadOnly}}" />
                <text>{{w}}</text>
              </view>
            </view>
          </radio-group>
        </view>
      </view>
    </view>
    
    <view class="form-item">
      <view class="form-item-header-inline">
        <text class="label label-inline">备注</text>
        <button wx:if="{{!isReadOnly}}" class="btn btn-attachment" bindtap="onAddAttachment">添加图片附件（可选）</button>
      </view>
      <textarea class="textarea" placeholder="可选（最多200个汉字）" value="{{remark}}" bindinput="onRemarkInput" disabled="{{isReadOnly}}" auto-height="{{true}}" maxlength="{{remarkMaxLen}}" />
      <view wx:if="{{attachmentItems.length > 0}}" class="attachment-list">
        <view wx:for="{{attachmentItems}}" wx:key="index" class="attachment-item">
          <image class="attachment-thumb" mode="aspectFill" src="{{item.previewUrl}}" data-index="{{index}}" bindtap="onPreviewAttachment" />
          <view wx:if="{{!isReadOnly}}" class="attachment-remove" data-index="{{index}}" bindtap="onRemoveAttachment">删除</view>
        </view>
      </view>
    </view>
    
    <view wx:if="{{isEdit && isCreator && !isReadOnly}}" class="form-item form-actions-bottom">
      <button class="btn btn-delete" bindtap="deleteBill">删除账单</button>
    </view>
  </view>

  <canvas canvas-id="attachmentCanvas" class="attachment-canvas" style="width: {{attachmentCanvasWidth}}px; height: {{attachmentCanvasHeight}}px;"></canvas>
</view>
