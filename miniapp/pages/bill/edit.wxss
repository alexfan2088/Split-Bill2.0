/* pages/bill/edit.wxss */
.container {
  padding: 20rpx;
  background-color: #f5f5f5;
  min-height: 100vh;
}

.form {
  background-color: white;
  border-radius: 8rpx;
  padding: 30rpx;
}

.form-item {
  margin-bottom: 40rpx;
}

.form-item-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.form-item-header-inline {
  display: flex;
  align-items: center;
  justify-content: flex-start;
  gap: 12rpx;
  margin-bottom: 16rpx;
  padding-right: 0;
}

.label-inline {
  flex: 1;
  margin-bottom: 0;
}

.form-item-header-inline .btn-save {
  flex: 1;
}

.form-item-header-inline .btn-attachment {
  flex: 0;
}

.form-actions {
  display: flex;
  gap: 12rpx;
  align-items: center;
}

.form-actions-bottom {
  display: flex;
  justify-content: flex-start;
  align-items: center;
  margin-top: 20rpx;
  padding-top: 20rpx;
}

.form-actions-bottom .btn {
  flex: 0;
  width: auto;
  min-width: 480rpx;
  padding: 16rpx 32rpx;
}

.label {
  display: block;
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

.hint {
  font-size: 24rpx;
  color: #999;
  margin-top: 8rpx;
}

.input {
  width: 100%;
  height: 80rpx;
  padding: 0 20rpx;
  border: 2rpx solid #ddd;
  border-radius: 8rpx;
  font-size: 28rpx;
}

.recent-titles {
  margin-top: 16rpx;
}

.recent-titles-label {
  font-size: 24rpx;
  color: #666;
  margin-bottom: 12rpx;
}

.title-input-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.input-title {
  flex: 1;
}

.btn-title-clear-inline {
  padding: 12rpx 24rpx;
  border: 2rpx solid #999;
  border-radius: 8rpx;
  font-size: 24rpx;
  color: #999;
  background-color: white;
  text-align: center;
  white-space: nowrap;
  flex-shrink: 0;
}

.btn-title-clear-inline:active {
  background-color: #f0f0f0;
}

.recent-titles-buttons {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  align-items: center;
}

.btn-title-item {
  padding: 12rpx 24rpx;
  border: 2rpx solid #007bff;
  border-radius: 8rpx;
  font-size: 24rpx;
  color: #007bff;
  background-color: white;
  text-align: left;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.btn-title-item-sub {
  font-size: 20rpx;
  color: #7a8ca3;
}

.btn-title-item:active {
  background-color: #e7f3ff;
  border-color: #0056b3;
}

.btn-title-clear {
  padding: 12rpx 24rpx;
  border: 2rpx solid #999;
  border-radius: 8rpx;
  font-size: 24rpx;
  color: #999;
  background-color: white;
  text-align: center;
}

.btn-title-clear:active {
  background-color: #f0f0f0;
}

.picker {
  width: 100%;
  height: 80rpx;
  padding: 0 20rpx;
  border: 2rpx solid #ddd;
  border-radius: 8rpx;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.datetime-row {
  display: flex;
  gap: 12rpx;
  align-items: center;
}

.picker-wrapper {
  flex: 0 0 33%;
  min-width: 0;
}

.picker-date {
  flex-basis: 33%;
}

.picker-time {
  flex-basis: 33%;
}

.datetime-spacer {
  flex: 0 0 25%;
  height: 1px;
}

.picker-inline {
  margin-bottom: 0;
  min-width: 0;
}

.picker-disabled {
  background-color: #f5f5f5;
  color: #999;
  border-color: #e0e0e0;
  opacity: 0.6;
}

.textarea {
  width: 100%;
  min-height: 100rpx;
  padding: 20rpx;
  border: 2rpx solid #ddd;
  border-radius: 8rpx;
  font-size: 28rpx;
  line-height: 1.5; /* 设置行高，使文字更紧凑 */
  box-sizing: border-box; /* 包含padding和border */
}

.attachment-list {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 16rpx;
}

.attachment-item {
  position: relative;
  width: 160rpx;
  height: 160rpx;
}

.attachment-thumb {
  width: 100%;
  height: 100%;
  border-radius: 8rpx;
  background-color: #f2f2f2;
}

.attachment-remove {
  position: absolute;
  right: 6rpx;
  top: 6rpx;
  padding: 4rpx 10rpx;
  font-size: 22rpx;
  color: #fff;
  background-color: rgba(0, 0, 0, 0.55);
  border-radius: 999rpx;
}

.attachment-canvas {
  position: absolute;
  left: -9999px;
  top: -9999px;
  width: 1px;
  height: 1px;
  opacity: 0;
}

.participants-list {
  margin-top: 16rpx;
}

.participant-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.participant-name {
  font-size: 28rpx;
  color: #333;
  width: 200rpx;
}

.weight-options {
  display: flex;
  gap: 20rpx;
  align-items: center;
}

.weight-option {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.weight-option text {
  font-size: 26rpx;
  color: #666;
}

.type-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.type-tag {
  padding: 12rpx 24rpx;
  border: 2rpx solid #ddd;
  border-radius: 8rpx;
  font-size: 26rpx;
  color: #666;
  background-color: #f9f9f9;
  transition: all 0.3s;
}

.type-tag.active {
  border-color: #007bff;
  background-color: #e7f3ff;
  color: #007bff;
  font-weight: 500;
}

.btn {
  border: none;
  border-radius: 8rpx;
  font-size: 28rpx;
  padding: 0;
  margin: 0;
  line-height: 1;
}

.btn-save {
  background-color: #007bff;
  color: white;
  padding: 16rpx 0;
  font-size: 26rpx;
  border-radius: 8rpx;
  flex: 1;
  text-align: center;
  box-sizing: border-box;
  margin: 0;
  white-space: nowrap;
}

.btn-attachment {
  background-color: #f1f5f9;
  color: #334155;
  padding: 12rpx 20rpx;
  font-size: 24rpx;
  border-radius: 8rpx;
  margin-left: auto;
  transform: translateX(-192rpx);
  min-width: 120rpx;
  text-align: center;
  white-space: nowrap;
}

.btn-attachment::after {
  border: none;
}

.btn-save::after {
  border: none;
}

.btn-delete {
  background-color: #dc3545;
  color: white;
  padding: 16rpx 32rpx;
  font-size: 26rpx;
  border-radius: 8rpx;
  text-align: center;
  box-sizing: border-box;
  margin: 0;
  white-space: nowrap;
}

.btn-delete::after {
  border: none;
}
